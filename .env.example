# client-exposed: inlined into the browser bundle at build time, safe to ship
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MODEL_ID=openai/gpt-oss-20b

# server-side secret: the app never reads this. the Supabase edge function does.
#   supabase secrets set MODEL_API_KEY=gsk_...
#   supabase functions deploy plan
#
# The edge function infers its host from the key's shape — gsk_ means Groq, nvapi- means NVIDIA NIM
# — so pointing production at a different host is a secrets change rather than a redeploy.
#
# The dev scripts below are the test surface and they run on NIM, deliberately, so that iterating does
# not spend the production budget. Give them their own key:
#   NIM_API_KEY=nvapi-...
# When both are set, the scripts use NIM_API_KEY and the deployed app uses MODEL_API_KEY.
NIM_API_KEY=

# production key, read by the edge function. optional locally: the scripts fall back to NIM_API_KEY.
MODEL_API_KEY=

# optional. override the endpoint, or let the key shape decide (see scripts/provider.ts)
# MODEL_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# MODEL_ID=openai/gpt-oss-20b

# prints prompt_tokens, cached_tokens and elapsed ms per model call. invaluable when tuning
# latency, noise otherwise.
VITE_LLM_TIMING=

# optional, only used by OpenRouter-style attribution headers
# MODEL_REFERER=
# MODEL_TITLE=
